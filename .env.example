# Copy to .env and fill in. Never commit .env.
OLFA_DOMAIN=olfa.example.com
OLFA_PUBLIC_URL=https://olfa.example.com
# Needed for the AI chat and AI explanations. Without it Hachi answers with a simple built-in reply.
GEMINI_API_KEY=
# Groq fallback used when Gemini is rate-limited or missing.
GROQ_API_KEY=
# Scan limits per visitor address
OLFA_SCAN_PER_MIN=30
OLFA_SCAN_PER_HOUR=600
# Optional: anchor the report ledger on a public TESTNET (use a throwaway wallet with free faucet coins only)
# See ANCHOR_SETUP.md. Never commit the key.
# OLFA_ANCHOR_RPC=https://...
# OLFA_ANCHOR_KEY=
# OLFA_ANCHOR_CHAIN_ID=11155111
# OLFA_ANCHOR_MIN_SECONDS=600
# Optional limits for the message checker
# OLFA_MSG_PER_MIN=10
# OLFA_MSG_PER_HOUR=200
# Optional: URLhaus threat feed (OpenPhish needs no key)
# URLHAUS_AUTH_KEY=
