{
  "model_version": "olfa-url-v1",
  "positive_label": 1,
  "positive_label_meaning": "legitimate",
  "ensemble": "0.5*xgb_probability + 0.5*char_logistic_probability",
  "threshold_legitimate": 0.5,
  "numeric_features": [
    "url_len",
    "host_len",
    "path_query_len",
    "num_dots",
    "num_hyphens",
    "num_underscores",
    "num_slashes",
    "num_at",
    "num_question",
    "num_equal",
    "num_ampersand",
    "num_percent",
    "num_digits",
    "digit_ratio",
    "num_letters",
    "num_special",
    "url_entropy",
    "host_entropy",
    "subdomain_count",
    "is_ip_host",
    "https",
    "port_nonstandard",
    "punycode",
    "has_hex_escape",
    "suspicious_word_count",
    "longest_label",
    "tld_len"
  ],
  "training_dataset": "PhiUSIIL_Phishing_URL_Dataset.csv",
  "split": "GroupShuffleSplit by registrable domain; 80/20; random_state=42",
  "metrics": {
    "roc_auc": 0.9987393024739216,
    "average_precision": 0.9986653431897246,
    "precision_legitimate": 0.9962656215336834,
    "recall_legitimate": 0.9999628887404438,
    "f1_legitimate": 0.9981108312342569
  }
}