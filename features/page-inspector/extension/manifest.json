{
  "manifest_version": 3,
  "name": "Olfa — Page Inspector",
  "version": "1.0.0",
  "description": "See what a site really collects: cookies, third-party requests, forms, storage and fingerprinting. Everything stays on your machine.",
  "minimum_chrome_version": "116",
  "permissions": ["cookies", "webRequest", "storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/inspect.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Inspect this page" },
  "web_accessible_resources": [{ "resources": ["assets/hachi.png"], "matches": ["<all_urls>"] }]
}
