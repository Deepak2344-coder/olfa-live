{
  "manifest_version": 3,
  "name": "Olfa Page Threat Detector",
  "version": "1.0.0",
  "description": "Content script that detects clickjacking, obfuscated JS, and permission abuse",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/agent.js"],
      "css": ["content/style.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "icons": {
    "48": "assets/hachi.png"
  }
}