# Copy to .env and fill in. Never commit .env.
OLFA_DOMAIN=olfa.example.com
OLFA_PUBLIC_URL=https://olfa.example.com
# Needed for the AI chat and AI explanations. Without it Hachi answers with a simple built-in reply.
GEMINI_API_KEY=
# Scan limits per visitor address
OLFA_SCAN_PER_MIN=30
OLFA_SCAN_PER_HOUR=600
